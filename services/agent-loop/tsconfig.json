{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "outDir": "dist", "rootDir": "src",
    "declaration": true, "sourceMap": true, "skipLibCheck": true, "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.mjs"]
}
