{
  "listen": ":8443",
  "tls": {
    "cert_file": "/run/easygo/identity/tls.crt",
    "key_file": "/run/easygo/identity/tls.key",
    "ca_file": "/run/easygo/trust/ca.crt"
  },
  "authorization": [
    {
      "id": "workshop",
      "cert_file": "/run/easygo/trust/workshop.crt",
      "methods": [
        "health"
      ],
      "namespaces": []
    },
    {
      "id": "agent-loop",
      "cert_file": "/run/easygo/trust/agent-loop.crt",
      "methods": [
        "health",
        "workshop.workflows",
        "workshop.submit",
        "workshop.get",
        "workshop.list",
        "workshop.cancel",
        "workshop.resume",
        "workshop.result",
        "workshop.events"
      ],
      "namespaces": [
        "*"
      ]
    }
  ],
  "workshop": {
    "root": "/data/workshop",
    "concurrency": 2,
    "queue_capacity": 8,
    "max_output_bytes": 4194304,
    "engines": {
      "codex": {
        "binary": "codex"
      },
      "claude": {
        "binary": "claude"
      },
      "pi": {
        "binary": "pi"
      },
      "openclaw": {
        "binary": "openclaw"
      }
    },
    "workflows": [
      {
        "name": "write-note",
        "version": "1",
        "instructions": "Write a concise Markdown note addressing the user input into note.md in the current workspace. End by summarizing what you wrote.",
        "policy": "workspace-write",
        "timeout_seconds": 300,
        "artifacts": [
          "note.md"
        ],
        "runtime": "pi-main",
        "allowed_runtimes": [
          "openclaw-main",
          "codex-responses",
          "claude-messages"
        ]
      }
    ],
    "model_gateway": {
      "url": "https://ai-gateway:8441/rpc",
      "peer_certificate_file": "/run/easygo/trust/ai-gateway.crt",
      "tls": {
        "cert_file": "/run/easygo/identity/tls.crt",
        "key_file": "/run/easygo/identity/tls.key",
        "ca_file": "/run/easygo/trust/ca.crt"
      }
    },
    "runtime_profiles": {
      "pi-main": {
        "engine": "pi",
        "protocol": "chat_completions",
        "gateway_model": "chat"
      },
      "openclaw-main": {
        "engine": "openclaw",
        "protocol": "chat_completions",
        "gateway_model": "chat"
      },
      "codex-responses": {
        "engine": "codex",
        "protocol": "responses",
        "gateway_model": "responses"
      },
      "claude-messages": {
        "engine": "claude",
        "protocol": "anthropic",
        "gateway_model": "claude"
      }
    }
  }
}
