# EasyGo 托管平台：cp .env.example .env，填好前两项，然后
#   docker compose up -d --build
# 其余各项都有默认值。改了 .env 以后再执行一次同样的命令即可生效。
# 值里有 $、# 或空格时，整个值用单引号括起来。

# ---- 必填 ----
# 模型供应商 key（DeepSeek）。只注入 ai-gateway 容器，不写进任何配置文件。
DEEPSEEK_API_KEY=
# 管理员初始密码，至少 12 个字符。只在第一次启动创建管理员时读取，之后可以删掉。
EASYGO_ADMIN_PASSWORD=

# ---- 常用 ----
# 管理员登录邮箱。要在第一次启动前定好。
EASYGO_ADMIN_EMAIL=admin@example.com
# Web 端口，默认只绑 127.0.0.1。
EASYGO_PORT=8090
# 浏览器实际访问的地址，协议、主机、端口都要和地址栏一致，否则登录会被拒绝。
# 默认 http://localhost:<EASYGO_PORT>。放在 HTTPS 反向代理后面时写 https 域名。
# EASYGO_PUBLIC_ORIGIN=https://agent.example.com
# 是否开放自助注册。新账户余额为 0，由管理员在 Web「管理」页发积分。
EASYGO_REGISTRATION=false

# ---- 进阶 ----
# 数据目录：数据库、内部证书、生成的配置、任务工作区。要整体备份。
# EASYGO_DATA_DIR=./state/platform
# 工坊用这个 Docker socket 启动任务容器，拿到它就等于拿到宿主 root，最好给平台单独一个 daemon。
# EASYGO_DOCKER_SOCKET=/var/run/docker.sock
# 同机 HTTPS 反向代理时填 Compose 网络的网关地址，多个用逗号分隔。
# EASYGO_TRUSTED_PROXIES=172.31.250.1
# 每个任务容器的资源上限。
# EASYGO_TASK_MEMORY_MIB=2048
# EASYGO_TASK_CPUS=1
# EASYGO_TASK_PIDS=256
# 网关给每次模型调用设的输出上限（token），也决定调用前要冻结多少额度。
# EASYGO_MAX_OUTPUT_TOKENS=32768
# Web 端口绑定的地址。改成 0.0.0.0 等于用明文 HTTP 对外开放，只在可信内网这样做。
# EASYGO_BIND=127.0.0.1
# Compose 网络。和宿主已有网段冲突时两项一起改，EASYGO_TRUSTED_PROXIES 也跟着改。
# EASYGO_PLATFORM_SUBNET=172.31.250.0/24
# EASYGO_PLATFORM_GATEWAY=172.31.250.1
# 任务镜像标签，默认由 deploy/runtime/Dockerfile 构建。
# EASYGO_RUNTIME_IMAGE=easygo-task-runtime:platform
# init 会通过 Docker socket 查出数据目录在宿主上的路径。查不到时（比如 socket 转发自别的机器）在这里写绝对路径。
# EASYGO_HOST_DATA_DIR=/srv/easygo/state/platform
