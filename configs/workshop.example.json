{
  "root": "./data/workshop",
  "concurrency": 2,
  "queue_capacity": 8,
  "max_output_bytes": 4194304,
  "bearer_token_env": "WORKSHOP_BEARER_TOKEN",
  "engines": {
    "codex": {
      "binary": "codex",
      "env_allowlist": ["OPENAI_API_KEY", "CODEX_HOME"]
    }
  },
  "workflows": [
    {
      "name": "write-note",
      "version": "1",
      "instructions": "Write a concise Markdown note addressing the user input into note.md in the current workspace. End by summarizing what you wrote.",
      "engine": "codex",
      "model": "YOUR_CODEX_MODEL_ID",
      "policy": "workspace-write",
      "timeout_seconds": 300,
      "artifacts": ["note.md"]
    }
  ]
}
