{
  "listen": ":8441",
  "tls": {
    "cert_file": "/run/easygo/identity/tls.crt",
    "key_file": "/run/easygo/identity/tls.key",
    "ca_file": "/run/easygo/trust/ca.crt"
  },
  "authorization": [
    {
      "id": "ai-gateway",
      "cert_file": "/run/easygo/trust/ai-gateway.crt",
      "methods": [
        "health"
      ],
      "namespaces": []
    },
    {
      "id": "agent-loop",
      "cert_file": "/run/easygo/trust/agent-loop.crt",
      "methods": [
        "health",
        "gateway.models",
        "gateway.generate"
      ],
      "namespaces": [
        "*"
      ]
    },
    {
      "id": "workshop",
      "cert_file": "/run/easygo/trust/workshop.crt",
      "methods": [
        "gateway.native"
      ],
      "namespaces": [
        "*"
      ]
    }
  ],
  "max_request_bytes": 16777216,
  "max_response_bytes": 16777216,
  "max_stream_bytes": 67108864,
  "max_event_bytes": 1048576,
  "models": {
    "chat": {
      "protocol": "chat_completions",
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "model": "YOUR_CHAT_MODEL_ID",
      "api_key_env": "OPENAI_API_KEY",
      "parameters": {
        "max_output_tokens": 4096
      }
    },
    "responses": {
      "protocol": "responses",
      "endpoint": "https://api.openai.com/v1/responses",
      "model": "YOUR_RESPONSES_MODEL_ID",
      "api_key_env": "OPENAI_API_KEY",
      "parameters": {
        "max_output_tokens": 4096,
        "store": false,
        "include": [
          "reasoning.encrypted_content"
        ]
      }
    },
    "claude": {
      "protocol": "anthropic",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "model": "YOUR_ANTHROPIC_MODEL_ID",
      "api_key_env": "ANTHROPIC_API_KEY",
      "parameters": {
        "max_output_tokens": 4096
      }
    },
    "custom": {
      "protocol": "custom",
      "endpoint": "https://your-provider.example/generate",
      "model": "YOUR_CUSTOM_MODEL_ID",
      "api_key_env": "CUSTOM_API_KEY",
      "parameter_map": {
        "top_p": "nucleus_probability"
      },
      "custom": {
        "request": {
          "model": "settings.model",
          "messages": "payload.messages",
          "tools": "payload.tools",
          "max_output_tokens": "settings.output_limit",
          "temperature": "settings.temperature",
          "tool_choice": "settings.tool_choice"
        },
        "response": {
          "id": "result.id",
          "content": "result.content",
          "finish_reason": "result.finish_reason",
          "usage.input_tokens": "usage.input",
          "usage.output_tokens": "usage.output",
          "usage.cache_read_tokens": "usage.cache_read",
          "usage.cache_write_tokens": "usage.cache_write"
        }
      }
    }
  }
}
