# 旧版本地应用（cmd/easygo-agent、compose.legacy.yaml）用，见 doc/legacy-local-app.md。
# 托管平台用 .env.example。
MODEL_API_KEY=
SUBMODEL_API_KEY=
DATABASE_URL=postgres://easygo:easygo@127.0.0.1:5432/easygo?sslmode=disable
MEMORY_DATABASE_URL=postgres://easygo:easygo@127.0.0.1:5432/easygo_memory?sslmode=disable

# Used only by the optional local Docker sandbox controller.
# Generate with: openssl rand -hex 32
SANDBOX_CONTROLLER_TOKEN=
# Linux normally uses /var/run/docker.sock. Docker Desktop may expose a
# per-user socket such as /Users/<user>/.docker/run/docker.sock.
DOCKER_SOCKET_PATH=/var/run/docker.sock


# Optional standalone services: export these variables before starting them.
AI_GATEWAY_BEARER_TOKEN=
WORKSHOP_BEARER_TOKEN=
